# Server Configuration
PORT=3001

# Default AI Provider: auto | gemini | openai | anthropic | heuristic
# "auto" selects the first configured LLM provider, falling back to the built-in heuristic AI.
AI_PROVIDER=auto

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# OpenAI API (or OpenAI-compatible endpoint such as Ollama / OpenRouter / DeepSeek)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
