{
  "name": "threekindom-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Three Kingdoms AI (三国志 AI) — Bilingual interactive grand strategy web game with pluggable LLM warlords & advisors",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "optimize:art": "node scripts/optimize-art.mjs",
    "portraits:standin": "tsx scripts/make-standin-portraits.ts",
    "build:terrain": "node scripts/build-terrain.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/three": "^0.187.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "world-atlas": "^2.0.2"
  }
}
